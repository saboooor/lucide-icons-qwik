{
  "name": "lucide-icons-qwik",
  "version": "1.25.0-qwik-v2",
  "private": false,
  "description": "Lucide icon library package for Qwik applications",
  "keywords": [
    "icon",
    "icons",
    "lucide",
    "qwik"
  ],
  "homepage": "https://github.com/saboooor/lucide-icons-qwik",
  "bugs": {
    "url": "https://github.com/saboooor/lucide-icons-qwik/issues"
  },
  "license": "LICENSE",
  "author": {
    "name": "saboooor",
    "url": "https://saboor.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saboooor/lucide-icons-qwik.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.qwik.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.qwik.mjs",
      "require": "./lib/index.qwik.cjs",
      "types": "./lib/index.d.ts"
    },
    "./base-icon": {
      "import": "./lib/components/base-icon.qwik.mjs",
      "require": "./lib/components/base-icon.qwik.cjs",
      "types": "./lib/components/base-icon.d.ts"
    },
    "./icons/*": {
      "import": "./lib/components/icons/*.qwik.mjs",
      "require": "./lib/components/icons/*.qwik.cjs",
      "types": "./lib/components/icons/*.d.ts"
    }
  },
  "scripts": {
    "build": "bun build.icons && qwik build",
    "build.icons": "bun build.ts",
    "build.lib": "vp build --mode lib",
    "build.types": "tsc -p tsconfig.types.json --emitDeclarationOnly --incremental false",
    "dev": "vp dev --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "vp lint",
    "release": "np",
    "start": "vp dev --open --mode ssr",
    "test": "echo \"No test specified\" && exit 0",
    "qwik": "qwik",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@8785",
    "@qwik.dev/router": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/router@8785",
    "@types/bun": "*",
    "globals": "^17.7.0",
    "lucide": "^1.25.0",
    "np": "^12.0.0",
    "oxlint-plugin-qwik": "^0.0.9",
    "ts-morph": "^28.0.0",
    "typescript": "7.0.2",
    "undici": "8.8.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5",
    "vite-tsconfig-paths": "^6.1.1",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=16.8.0 <18.0.0 || >=18.11"
  },
  "qwik": "./lib/index.qwik.mjs"
}
