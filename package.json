{
  "name": "lucide-icons-qwik",
  "version": "1.24.0-qwik-v2",
  "description": "Lucide icon library package for Qwik applications",
  "author": {
    "name": "saboooor",
    "url": "https://saboor.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saboooor/lucide-icons-qwik.git"
  },
  "license": "LICENSE",
  "keywords": [
    "icon",
    "icons",
    "lucide",
    "qwik"
  ],
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.qwik.mjs",
      "require": "./lib/index.qwik.cjs",
      "types": "./lib/index.d.ts"
    },
    "./icons/*": {
      "import": "./lib/components/icons/*.qwik.mjs",
      "require": "./lib/components/icons/*.qwik.cjs",
      "types": "./lib/components/icons/*.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=16.8.0 <18.0.0 || >=18.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun"
    }
  },
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "pnpm build.icons && qwik build",
    "build.icons": "bun build.ts",
    "build.lib": "vp build --mode lib",
    "build.types": "tsc -p tsconfig.types.json --emitDeclarationOnly --incremental false",
    "dev": "vp dev --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "vp lint",
    "release": "np",
    "start": "vp dev --open --mode ssr",
    "test": "echo \"No test specified\" && exit 0",
    "qwik": "qwik",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@qwik.dev/core": "2.0.0-beta.36",
    "@qwik.dev/router": "^2.0.0-beta.36",
    "@types/node": "^26.1.1",
    "globals": "^17.7.0",
    "lucide": "^1.24.0",
    "np": "^11.2.2",
    "oxlint-plugin-qwik": "^0.0.9",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.3",
    "undici": "8.7.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4",
    "vite-tsconfig-paths": "^6.1.1",
    "yargs": "^18.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  }
}
